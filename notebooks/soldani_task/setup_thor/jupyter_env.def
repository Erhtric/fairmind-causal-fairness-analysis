Bootstrap: docker
From: python:3.11-slim

%labels
    Author marco.soldani
    Purpose "Jupyter + FairMind deps per il benchmark causal fairness"

%post
    apt-get update && apt-get install -y --no-install-recommends \
        git build-essential && \
    rm -rf /var/lib/apt/lists/*

    # pgmpy pinnato alla stessa versione del .venv locale (1.0.0): versioni
    # piu' recenti hanno cambiato la firma di DiscreteBayesianNetwork.fit()
    # e rompono la chiamata con estimator_instance=(BayesianEstimator,
    # {"prior_type": "BDeu"}) usata in tutto il codice (src/model.py).
    pip install --no-cache-dir \
        jupyterlab \
        pandas \
        pgmpy==1.0.0 \
        networkx \
        loguru \
        openai \
        matplotlib \
        plotly \
        daft-pgm \
        tqdm ipywidgets

%help
    Ambiente per lanciare i notebook di benchmark su Thor.

    Build (sul login node, una tantum):
        apptainer build jupyter_env.sif jupyter_env.def

    Esecuzione del notebook in modalità automatica:
        apptainer exec jupyter_env.sif \
            jupyter nbconvert --to notebook --execute \
            --output benchmark_output.ipynb \
            2_3_benchmark_thor.ipynb
